<?xml version="1.0" encoding="utf-8"?>
<!-- Nécessaire uniquement pour Azure App Service sous Windows (iisnode).
     Inutile sur App Service Linux / Container Apps : tu peux le supprimer. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="DynamicContent">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode nodeProcessCommandLine="node server.js" />
  </system.webServer>
</configuration>
